{
 "note": "Expected values are the output of the browser prototype (docs/prototype/Main.dc.html), reviewed by hand. Areas are in model units squared. Faces are listed by ascending area. A hole list gives the vertex count of each hole loop. Rust must reproduce vertices, edges, faces, face_list and bbox (within the relative tolerance). Case \"start\":\"cube\" means the initial cube: x and y from -1 to 1, z from 1 to 3 (a 2 by 2 by 2 box).",
 "cases": [
  {
   "id": "triangle_makes_face",
   "doc": "Three segments forming a closed triangle make one face.",
   "start": "empty",
   "ops": [
    {
     "op": "segment",
     "p": [
      0,
      0,
      0
     ],
     "q": [
      4,
      0,
      0
     ]
    },
    {
     "op": "segment",
     "p": [
      4,
      0,
      0
     ],
     "q": [
      0,
      3,
      0
     ]
    },
    {
     "op": "segment",
     "p": [
      0,
      3,
      0
     ],
     "q": [
      0,
      0,
      0
     ]
    }
   ],
   "expect": {
    "vertices": 3,
    "edges": 3,
    "faces": 1,
    "face_list": [
     {
      "loop": 3,
      "holes": [],
      "area": 6
     }
    ],
    "bbox": {
     "min": [
      0,
      0,
      0
     ],
     "max": [
      4,
      3,
      0
     ]
    }
   },
   "status": "verified"
  },
